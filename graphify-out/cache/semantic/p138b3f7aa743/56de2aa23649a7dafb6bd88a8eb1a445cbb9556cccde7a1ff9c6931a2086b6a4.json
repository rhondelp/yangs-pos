ture_order_items", "label": "order_items table (price/cost snapshots)", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "L155", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_order_item_voids", "label": "order_item_voids table", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "L166", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_payments_table", "label": "payments table", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "L201", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_refunds_table", "label": "refunds table", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "L214", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_cash_movements", "label": "cash_movements table", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "L238", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_inventory_items", "label": "inventory_items table", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "L306", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_inventory_movements", "label": "inventory_movements ledger", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "L350", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_stock_receipts", "label": "stock_receipts table", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "L323", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_activity_logs", "label": "activity_logs table", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "L94", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_expenses", "label": "expenses table", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "L373", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_payroll_records", "label": "payroll_records table", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "L447", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_schedules_exclusion_constraint", "label": "Schedules Overlap Exclusion Constraint", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": "L546", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "gist exclusion on tstzrange rejects overlapping shifts at the DB, including shifts across midnight."}, {"id": "docs_architecture_derived_table_status", "label": "Derived Table Status and Session Lifecycle", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": "L559", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two stored statuses that must agree will eventually disagree; Occupied/Awaiting Payment derive from the open session. One open primary session per table enforced by partial unique index."}, {"id": "docs_architecture_tab_actions", "label": "Tab Actions: Move, Merge, Split (child sessions)", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": "L584", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Split bills as child sessions so payments, receipts and totals need no special cases; rejected payment allocation to order items. Allowed only before any payment."}, {"id": "docs_architecture_stock_deduction_on_send", "label": "Stock Deduction on Send Round", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": "L595", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Drinks leave the shelf when ordered; deduct at send in one transaction. Voids ask return-to-stock; never block on negative stock (owner decision)."}, {"id": "docs_architecture_weighted_average_cost", "label": "Moving Weighted Average Cost (WAC)", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": "L609", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen over FIFO (cost layers, much more code) and standard cost (drifts). Cost snapshot taken at send under lock."}, {"id": "docs_architecture_money_precision", "label": "Money Precision: totals 12,2 and unit costs 14,6", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": "L620", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-ml costs cannot be stored at 2 decimals without error on every shot; bcmath with round half-up to 2 decimals for amounts."}, {"id": "docs_architecture_recipe_components", "label": "Recipe Components (case-to-bottle, bottle-to-shot)", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": "L626", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One recipe table covers bottles, buckets, shots and cocktails, so no separate conversion and bundle features. Base unit plus inventory_units factors."}, {"id": "docs_architecture_accounting_separation", "label": "Revenue, Purchases, COGS, OpEx and Payroll Separation", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": "L645", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each figure has one source table; no Product purchases or Salaries expense categories; cash drawer movements never in P&L; purchases become COGS only when sold."}, {"id": "docs_architecture_business_date", "label": "Business Date Cutoff (06:00)", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": "L672", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "business_date stored at write time via BusinessDate::for so later cutoff changes never move past records between days."}, {"id": "docs_architecture_payment_service", "label": "PaymentService::record()", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "L681", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only code path that closes a session: lockForUpdate session, recompute net total, validate, insert payment, freeze totals and VAT when paid >= net."}, {"id": "docs_architecture_cashier_shifts", "label": "Cashier Shifts and Expected Drawer Cash", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "L226", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_discounts", "label": "Discounts (line/bill, percent/amount, frozen at close)", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "L692", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_approval_service", "label": "Supervisor PIN Approval (ApprovalService)", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "L700", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_vat", "label": "VAT Setting (inclusive, frozen at close)", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "L706", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_rbac", "label": "RBAC with spatie/laravel-permission", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": "L712", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Permissions through roles only; Owner locked with all permissions explicitly, no Gate::before bypass, so policies still enforce business rules."}, {"id": "docs_architecture_permission_enum", "label": "App\\Enums\\Permission catalogue", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "L716", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_users_vs_employees", "label": "Users vs Employees", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "L751", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_activity_logger", "label": "ActivityLogger Service", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "L755", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Called inside the same transaction as the change; custom table instead of spatie/laravel-activitylog (not pre-approved, little benefit)."}, {"id": "docs_architecture_concurrency_lock_order", "label": "Concurrency and Lock Order", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": "L761", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lock order session then inventory items sorted by id prevents deadlocks; reference numbers from row ids avoid counter tables."}, {"id": "docs_architecture_notifications", "label": "Database Notifications (stock, voids, pending payment)", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "L767", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_alpine_js_frontend", "label": "Alpine.js + fetch to /api/v1 for POS", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": "L782", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No server round trip per tap and POS exercises the same API as the mobile app; Livewire rejected as laggy on bar Wi-Fi, vanilla JS too much DOM code."}, {"id": "docs_architecture_stock_service", "label": "StockService (sole writer of inventory movements)", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "L817", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_money_support", "label": "Money and BusinessDate support classes", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "L798", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_folder_structure", "label": "Folder Structure (thin controllers, services own transactions)", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "L792", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_phased_plan", "label": "Phased Implementation Plan (46 steps, 8 phases)", "file_type": "document", "source_file": "docs/ARCHITECTURE.md", "source_location": "L853", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_open_questions", "label": "Open Questions (hosting, Senior/PWD, payroll rules)", "file_type": "document", "source_file": "docs/ARCHITECTURE.md", "source_location": "L919", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_architecture", "target": "docs_architecture_owner_decisions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "sou