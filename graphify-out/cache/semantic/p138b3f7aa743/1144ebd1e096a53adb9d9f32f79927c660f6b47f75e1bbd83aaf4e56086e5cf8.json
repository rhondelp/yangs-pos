{"nodes": [{"id": "docs_superpowers_specs_2026_11_19_voids_refunds_corrections_design", "label": "Voids, Refunds and Corrections Design", "file_type": "document", "source_file": "docs/superpowers/specs/2026-11-19-voids-refunds-corrections-design.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Undo mistakes after money is involved without editing or deleting history; every undo is a new record with a reason."}, {"id": "docs_superpowers_specs_2026_11_19_voids_refunds_corrections_design_void_rule", "label": "Void rule (live tab with payment; order_voids append-only)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-11-19-voids-refunds-corrections-design.md", "source_location": "L10-L17", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One clear line between cancel (before payment) and void (after payment); total may not drop below paid, and landing exactly on it closes the tab."}, {"id": "docs_superpowers_specs_2026_11_19_voids_refunds_corrections_design_void_amount_formula", "label": "Void amount = unit_price x v - prorate(d, v, q), bill recomputed from totals", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-11-19-voids-refunds-corrections-design.md", "source_location": "L15", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recomputing from totals rather than summing stored amounts prevents rounding drift."}, {"id": "docs_superpowers_specs_2026_11_19_voids_refunds_corrections_design_refund_rule", "label": "Refund rule (closed tabs only, per payment, idempotent, no stock movement)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-11-19-voids-refunds-corrections-design.md", "source_location": "L19-L26", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Drinks served stay in COGS, so refunds move no stock (ARCHITECTURE 3.6)."}, {"id": "docs_superpowers_specs_2026_11_19_voids_refunds_corrections_design_correction_rule", "label": "Payment correction (effective method/reference, latest wins)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-11-19-voids-refunds-corrections-design.md", "source_location": "L28-L32", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A cash payment that gave change cannot move to another method because change proves it was cash."}, {"id": "docs_superpowers_specs_2026_11_19_voids_refunds_corrections_design_approval_pin", "label": "Optional approval PIN (require_approval_pin, approvals.grant, 5/min rate limit)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-11-19-voids-refunds-corrections-design.md", "source_location": "L34-L39", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_11_19_voids_refunds_corrections_design_transactions_screen", "label": "Transactions pages (/transactions list and detail)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-11-19-voids-refunds-corrections-design.md", "source_location": "L46-L47", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_superpowers_specs_2026_11_19_voids_refunds_corrections_design", "target": "docs_superpowers_specs_2026_11_19_voids_refunds_corrections_design_void_rule", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-11-19-voids-refunds-corrections-design.md", "source_location": "L10", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_11_19_voids_refunds_corrections_design", "target": "docs_superpowers_specs_2026_11_19_voids_refunds_corrections_design_refund_rule", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-11-19-voids