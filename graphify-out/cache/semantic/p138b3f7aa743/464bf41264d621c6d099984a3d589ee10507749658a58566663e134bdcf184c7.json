{"nodes": [{"id": "docs_architecture_yangs_architecture", "label": "YANGS Architecture and Database Design", "file_type": "document", "source_file": "docs/ARCHITECTURE.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Favors correctness of money and stock first, then cashier speed, then everything else. Spec wins on conflict."}, {"id": "docs_architecture_anti_goals", "label": "Anti-goals (bill Paid without payments, history-altering price changes, double-counted profit)", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": "L25", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_owner_decisions", "label": "Owner Decisions (2026-11-18 Q&A)", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "L32", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "VAT off by default, manual discounts, allow negative stock and never block service, PIN approval on same device, no printer yet (80mm on-screen/PDF)."}, {"id": "docs_architecture_erd", "label": "Entity-Relationship Diagram (all modules)", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "L45", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The ERD is the contract migrations follow; tables are built per module in their step."}, {"id": "docs_architecture_append_only_tables", "label": "Append-only Tables with Rejecting Trigger", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": "L555", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "activity_logs, inventory_movements, payments, refunds, product_price_histories, cash_movements: history cannot be edited or deleted, even by a bug."}, {"id": "docs_architecture_one_open_tab_per_table_index", "label": "Partial Unique Index table_sessions_one_open_per_table", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "L545", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Opening a second tab fails at the database even if two tablets tap at the same moment."}, {"id": "docs_architecture_table_status_lifecycle", "label": "Table Status vs Table Session Lifecycle", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": "L560", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Status is stored because the owner asked; drift is handled by a single writer (TableStatusService) called in the same transaction as session changes. Tradeoff: any other writer could desync."}, {"id": "docs_architecture_tab_actions", "label": "Tab Actions: Move, Merge, Split (child sessions)", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": "L588", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Child sessions chosen over payment allocations so payments, receipts and totals need no special cases. Only allowed before any payment."}, {"id": "docs_architecture_stock_deduction_on_send", "label": "Stock Deducted on Send Round", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": "L599", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Matches bar reality (drinks leave the shelf when ordered); deduct at payment would leave stock wrong all night. Never block on negative stock; cancels ask return-to-stock."}, {"id": "docs_architecture_weighted_average_cost", "label": "Moving Weighted Average Cost (WAC) and Cost Snapshots", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": "L618", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "FIFO needs cost layers for no real benefit in a bar; standard cost drifts. WAC is usual for small F&B. Known limit: items sold at negative stock use old average."}, {"id": "docs_architecture_money_precision", "label": "Money Precision: decimal(12,2) totals, decimal(14,6) unit costs", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": "L629", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-ml cost cannot be stored at 2 decimals without error on every shot; all math in bcmath, rounded half-up when it becomes an amount."}, {"id": "docs_architecture_recipe_components", "label": "Recipe Components (case-to-bottle, bottle-to-shot)", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": "L635", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One recipe table covers bottles, buckets, shots and cocktails, so no separate conversion and bundle features. Base unit plus inventory_units factors."}, {"id": "docs_architecture_accounting_separation", "label": "Revenue, Purchases, COGS, OpEx and Payroll Separation", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": "L654", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each figure has exactly one source table. No Product purchases or Salaries expense categories; advances are not expenses; cash drawer movements never in P&L."}, {"id": "docs_architecture_business_day_cutoff", "label": "Business Day Cutoff (06:00) and BusinessDate", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "L681", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "business_date stored at write time so changing the cutoff never moves past records between days."}, {"id": "docs_architecture_schedule_exclusion_constraint", "label": "Schedule Overlap Exclusion Constraint (btree_gist)", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "L547", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compares real time ranges, so overlapping shifts across midnight are rejected by the database."}, {"id": "docs_architecture_payment_design", "label": "Payments Design (session-level, close only in PaymentService)", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": "L690", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Payments attach to the session; one transaction locks the session, recomputes totals, inserts the payment and closes when paid >= net total. No other code path closes a session."}, {"id": "docs_architecture_cashier_shifts", "label": "Cashier Shifts and Expected Drawer Cash", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "L699", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_discount_design", "label": "Discounts (line or bill, percent or amount, frozen at close)", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "L701", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_supervisor_pin_approval", "label": "Supervisor PIN Approval", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "L709", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_vat", "label": "VAT (inclusive, frozen on session at close)", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "L715", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Freezing rate and amount means toggling VAT later never changes past bills."}, {"id": "docs_architecture_rbac", "label": "RBAC with spatie/laravel-permission (roles only, no Gate::before)", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": "L721", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Owner gets every permission explicitly instead of a super-admin bypass, so policies still apply business rules (nobody can void a closed bill)."}, {"id": "docs_architecture_users_vs_employees", "label": "Users vs Employees", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "L760", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_audit_trail_design", "label": "Audit Trail via ActivityLogger in same transaction", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": "L764", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Custom table instead of spatie/laravel-activitylog (not pre-approved, adds little). Same transaction: rolled-back change leaves no log."}, {"id": "docs_architecture_concurrency_lock_order", "label": "Concurrency: lockForUpdate, lock order session then inventory items", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": "L770", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fixed lock order prevents deadlocks when two tablets send rounds sharing items."}, {"id": "docs_architecture_notifications", "label": "Database Notifications (stock alerts, voids, pending payment, shifts)", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "L776", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_alpine_js_frontend", "label": "Alpine.js + fetch to /api/v1 for POS", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": "L791", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No server round trip per tap; POS uses the same API the mobile app will. Livewire laggy on bar Wi-Fi; vanilla JS too much DOM code."}, {"id": "docs_architecture_folder_structure", "label": "Folder Structure (thin controllers, services own transactions)", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "L801", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_stockservice", "label": "StockService (only writer of inventory_movements)", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "L826", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_profit_loss", "label": "ProfitLossService and P&L", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "L829", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_phased_plan", "label": "Phased Implementation Plan (8 phases, 46 steps)", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "L862", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_open_questions", "label": "Open Questions (hosting, Senior/PWD, cutoff, payroll rules, precision)", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "L928", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_architecture_yangs_architecture", "target": "docs_architecture_owner_decisions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ARCHITECTURE.md", "source_location": "L32", "weight": 1.0}, {"source": "docs_architecture_yangs_architecture", "target": "docs_architecture_erd", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ARCHITECTURE.md", "s